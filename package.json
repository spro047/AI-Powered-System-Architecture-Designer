{
  "name": "archigen",
  "private": true,
  "description": "AI-Powered High-Level System Architecture Designer",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo clean",
    "seed": "turbo --filter=@archigen/backend seed"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.15",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "npm@11.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.11.1",
    "dagre": "^0.8.5"
  }
}
